# Optional public analytics settings. Empty values disable tracking.
# Copy to .env.local for local production builds, or .env for Docker Compose.
# These values are baked into the export; changing them requires a rebuild.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=brunopinto.net,www.brunopinto.net
